# Public client configuration. EXPO_PUBLIC_ values are embedded in the client
# bundle, so never put a server secret here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_REVENUECAT_WEB_PUBLIC_KEY=
EXPO_PUBLIC_DATA_PROVIDER_MODE=mock
EXPO_PUBLIC_PLACE_PROVIDER=geoapify
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPPORT_EMAIL=

# Server-side provider secrets belong in the local Supabase or Worker secret
# store and must never be committed.
