# Edge Functions 用 secrets (spec.md §34)
# ローカル: このファイルを supabase/functions/.env にコピーして値を入れる (gitignore 済み)
# 本番:     supabase secrets set KEY=value
# SUPABASE_SERVICE_ROLE_KEY は自動注入されるため書かない

DATA_PROVIDER_MODE=mock            # live | mock (§5.4 Fallback)
# RevenueCat server-only boundary. Never prefix these with EXPO_PUBLIC_.
REVENUECAT_WEBHOOK_TOKEN=
REVENUECAT_WEBHOOK_HMAC_SECRET=
REVENUECAT_SECRET_API_KEY=
# Exact app ID or comma-separated allow-list for the project's Apple/Google apps.
REVENUECAT_APP_ID=
REVENUECAT_ALLOWED_ENVIRONMENTS=SANDBOX # production workflow enforces PRODUCTION
# OneSignal App IDは公開識別子だが、server設定もclient buildと同じUUIDへ固定する。
# App API keyはserver-only。PUSH_NOTIFICATIONS_ENABLED=trueはnative実機確認後だけ設定する。
PUSH_NOTIFICATIONS_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RATE_LIMIT_SECRET=                 # 本番必須: 32文字以上。GitHub SecretからWorker/Functionsへ同期
EGRESS_GATEWAY_SECRET=             # 本番必須: 32文字以上。RATE_LIMIT_SECRETとは別値
INTERNAL_INVOKE_SECRET=            # 本番必須: 自己再呼出し専用。上記・queue・webhookとは別値
# INTERNAL_INVOKE_SECRET_PREVIOUS= # rotation中だけ検証用に設定し、15秒超の移行後に削除
SSRF_EGRESS_POLICY=deny-private-public-egress-v1
SSRF_EGRESS_GATEWAY_URL=https://api.oisint.com/v1/internal/egress-fetch
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_USER_HOURLY=10
RATE_LIMIT_CREATE_USER_DAILY=30
RATE_LIMIT_CREATE_IP_HOURLY=30
RATE_LIMIT_RUN_USER_HOURLY=20
RATE_LIMIT_RUN_USER_DAILY=60
RATE_LIMIT_RUN_IP_HOURLY=60
RATE_LIMIT_RERANK_USER_HOURLY=60
RATE_LIMIT_RERANK_USER_DAILY=200
RATE_LIMIT_RERANK_IP_HOURLY=180
RATE_LIMIT_JOIN_USER_HOURLY=10
RATE_LIMIT_JOIN_USER_DAILY=30
RATE_LIMIT_JOIN_IP_HOURLY=30
LIVE_COST_GUARD_ENABLED=true
LIVE_KILL_SWITCH=false              # 緊急停止。通常はDB runtime_controlsを使用
LIVE_DAILY_BUDGET_USD=5.00
LIVE_MONTHLY_BUDGET_USD=50.00
LIVE_ESTIMATED_CREATE_COST_USD=0.01
LIVE_ESTIMATED_RUN_COST_USD=0.05
# Plus run reservation and every research stage width must be explicit server
# config; blank/invalid values make Plus acceptance fail closed (no Free fallback).
LIVE_PLUS_ESTIMATED_RUN_COST_USD=
LIVE_PLUS_BROAD_CANDIDATE_LIMIT=       # integer 4..100; no product default
LIVE_PLUS_PRE_RANK_CANDIDATE_LIMIT=   # integer 4..100; <= Broad
LIVE_PLUS_RESEARCH_CANDIDATE_LIMIT=   # integer 4..100; <= pre-rank
LIVE_PLUS_PROVIDER_CALL_LIMIT=        # integer 4..100; >= Research
LIVE_ESTIMATED_RERANK_COST_USD=0.03
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MAX_CONCURRENCY=2           # Gemini 同時呼び出し上限 1〜2 (§5)
GEMINI_THINKING_LEVEL=low          # minimal | low | medium | high (出力トークン削減 #126。thought は保存しない §5)
# 暴走保険。小さすぎると Structured Output が途中切断され Zod 失敗 → unknown 化する。
# 8192 は候補 × requirement が増えると findings が収まらず #514 の unknown 高率と
# 同じ経路に落ちるため 16384 へ引き上げた (#552。pre-rank が Gemini 呼び出し数を減らす分、
# 1 回あたりの品質 budget は戻してよい)
GEMINI_MAX_OUTPUT_TOKENS=16384
SERPER_API_KEY=
# live の discovery provider (#530 / #297)。HotPepper は撤去済み。
PLACE_PROVIDER=geoapify
RAIL_LOCATION_RESOLVER_ENABLED=false  # N02 rail resolver; enable only after shadow/staging verification
# RAIL_LOCATION_RESOLVER_ENABLED=true requires explicit discovery budgets.
RAIL_DISCOVERY_PER_ANCHOR_LIMIT=       # positive integer; recall per station anchor
RAIL_DISCOVERY_MAX_PROVIDER_CALLS=     # positive integer; must cover every resolved anchor
RAIL_DISCOVERY_BROAD_LIMIT=3           # positive integer; cheap pre-rank output bound
GEOAPIFY_API_KEY=                  # live の Geoapify Places API に必須
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# ============================================================
# Pre-Rank ステージ (#552)
# Broad Discovery で広げた候補を、高価な Web Research + Gemini Judge へ
# 渡す前に安価に絞る段。最終表示は §5.4 Hard Rule 2 に従い常に 3 件固定。
# Freeは各stage 3件固定。PlusのBroad/pre-rank/research/provider上限は
# stage別server snapshotで決まる（Broad >= pre-rank >= Research、provider >= Research）。
# ============================================================
PRE_RANK_PROVIDER=deterministic    # deterministic | openrouter | mock。DATA_PROVIDER_MODE=mock では常に mock
BROAD_CANDIDATE_LIMIT=3            # policy上限を運用上縮小する場合のみ指定
EXPLORATION_SLOTS=0                # Research枠のうち探索枠 (policy上限まで)
PRE_RANK_TIMEOUT_MS=15000          # pre-rank の 1 回あたり timeout。超過は決定論 fallback
# pre-rank の出力上限。未設定なら候補数から自動見積もり (10240 + 240/候補、上限 32768)。
# 値を入れるとその固定値が優先される (benchmark で枠を固定したいとき用)
PRE_RANK_MAX_OUTPUT_TOKENS=
# thinking の強さ。既定 none = 推論を切る。
# DeepSeek V4 系は thinking 既定 ON・effort 既定 high で、reasoning tokens も
# max_tokens の内枠として課金されるため、切らないと枠を食い潰して
# finish_reason=length → 毎回 deterministic fallback になる。
# A/B 比較のときだけ low / high 等へ上げる (budget は出力枠の 1/4 に自動制限)
PRE_RANK_REASONING_EFFORT=none
# PRE_RANK_PROVIDER=openrouter のとき使う (OpenAI 互換 endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# benchmark の再現性用に host provider を pin する (カンマ区切り)。
# 空なら OpenRouter の自動 routing に任せる (可用性優先。品質比較には使わない)
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_APP_URL=https://oisint.com   # 任意。OpenRouter のランキング表示用ヘッダ
OPENROUTER_APP_TITLE=OISINT             # 任意
