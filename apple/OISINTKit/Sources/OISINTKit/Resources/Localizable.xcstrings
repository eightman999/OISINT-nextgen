        }
      }
    },
    "Plusの状態を解除できません。次回起動時に再試行します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't clear your Plus status. We'll retry next time the app starts."
