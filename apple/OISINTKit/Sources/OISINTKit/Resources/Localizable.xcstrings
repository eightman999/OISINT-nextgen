        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12文字以上で、英大文字・英小文字・数字を含めてください。"
          }
        }
      }
    },
    "1位候補ですが、必須条件が未確認のためおすすめ未確定です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top candidate, but not yet recommended because required conditions are unconfirmed"
